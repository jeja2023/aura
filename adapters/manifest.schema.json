{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/adapter-manifest-v1.json",
  "title": "Aura adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "code", "name", "version", "protocol", "lifecycle", "implementationStatus", "auraVersions", "capabilities", "configuration", "contract", "security", "support"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "protocol": { "type": "string", "minLength": 1, "maxLength": 64 },
    "lifecycle": { "enum": ["experimental", "certified", "deprecated", "unsupported"] },
    "implementationStatus": { "enum": ["supported", "experimental", "planned", "deprecated"] },
    "auraVersions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "configuration": { "type": "object" },
    "contract": {
      "type": "object",
      "required": ["healthPath", "discoveryPath", "samplePath", "timeoutSeconds", "errorCodes"],
      "properties": {
        "healthPath": { "type": ["string", "null"] },
        "discoveryPath": { "type": ["string", "null"] },
        "samplePath": { "type": ["string", "null"] },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "errorCodes": { "type": "object" }
      }
    },
    "security": {
      "type": "object",
      "required": ["credentialMode", "secretReferencesOnly", "networkDirection", "ssrfPolicy", "binaryProvenance"],
      "properties": {
        "credentialMode": { "type": "string" },
        "secretReferencesOnly": { "type": "boolean" },
        "networkDirection": { "type": "string" },
        "ssrfPolicy": { "type": "string" },
        "binaryProvenance": { "type": "string" }
      }
    },
    "support": {
      "type": "object",
      "required": ["knownLimitations", "vulnerabilityResponse", "owner"],
      "properties": {
        "knownLimitations": { "type": "array", "items": { "type": "string" } },
        "vulnerabilityResponse": { "type": "string" },
        "owner": { "type": "string" }
      }
    }
  }
}
