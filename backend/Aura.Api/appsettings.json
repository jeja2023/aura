{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Jwt": {
    "Key": "PLEASE_SET_IN_ENV_OR_APPSETTINGS_DEVELOPMENT",
    "Issuer": "Aura.Api",
    "Audience": "Aura.Client",
    "ExpireMinutes": 480
  },
  "Security": {
    "HmacSecret": "PLEASE_SET_IN_ENV_OR_APPSETTINGS_DEVELOPMENT",
    "CaptureAllowedClockSkewSeconds": 300,
    "CaptureIpWhitelist": [
      "::1",
      "127.0.0.1"
    ],
    "Cookies": {
      "ForceSecure": false
    },
    "StepUp": {
      "AllowLocalSuperAdmin": false
    },
    "ForwardedHeaders": {
      "Enabled": false,
      "ForwardLimit": 2,
      "AllowUnknownProxies": false,
      "KnownProxies": [],
      "KnownNetworks": []
    },
    "CspPolicy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:;"
  },
  "Ai": {
    "BaseUrl": "http://127.0.0.1:8000",
    "BaseUrls": "",
    "ApiKey": ""
  },
  "MediaAnalysis": {
    "PublicWebhookUrl": "http://127.0.0.1:5000/api/integrations/media-analysis/v1/events",
    "Webhook": {
      "AllowedClockSkewSeconds": 300,
      "MaxBodyBytes": 2097152,
      "MaxBatchSize": 200
    },
    "Http": {
      "TotalTimeoutSeconds": 120,
      "AttemptTimeoutSeconds": 30,
      "MaxRetryAttempts": 2,
      "ConnectTimeoutSeconds": 10,
      "MaxRequestBytes": 1048576,
      "MaxResponseBytes": 4194304,
      "OAuthMaxResponseBytes": 65536,
      "Mtls": {
        "CertificatePath": "",
        "CertificatePassword": "",
        "CertificatePasswordEnvironmentVariable": ""
      }
    },
    "OutboundSecurity": {
      "AllowedHosts": [],
      "AllowPrivateNetworks": false,
      "AllowLoopback": true,
      "AllowHttp": false,
      "AllowHttpForLoopback": true
    },
    "Inbox": {
      "AllowedLatenessSeconds": 30,
      "MaxAttempts": 8
    },
    "Readiness": {
      "WorkerStaleSeconds": 30,
      "HeartbeatTimeoutSeconds": 120
    },
    "Artifacts": {
      "Enabled": true,
      "PollMilliseconds": 1000,
      "MaxAttempts": 8,
      "MaxBytes": 26214400,
      "TimeoutSeconds": 60,
      "ConnectTimeoutSeconds": 10,
      "MaxRedirects": 3,
      "AllowedContentTypes": [ "image/", "video/", "application/octet-stream" ]
    },
    "Workers": {
      "Enabled": false,
      "JobPollMilliseconds": 1000,
      "SubscriptionPollSeconds": 5,
      "InboxPollMilliseconds": 500,
      "InboxBatchSize": 50
    }
  },
  "VectorIndex": {
    "ReadEngine": "pgvector",
    "WriteMode": "pgvector",
    "AllowLegacyReadFallback": false,
    "DefaultModelCode": "legacy-reid",
    "DefaultModelVersion": "default",
    "Compensation": {
      "Enabled": true,
      "PollMilliseconds": 1000,
      "MaxAttempts": 12
    },
    "LegacyArango": {
      "BaseUrl": "http://127.0.0.1:8529",
      "Database": "aura",
      "Collection": "person_features",
      "Username": "",
      "Password": "",
      "TotalTimeoutSeconds": 120,
      "AttemptTimeoutSeconds": 30,
      "MaxRetryAttempts": 2
    }
  },
  "CommercialProduct": {
    "HighRiskWorker": {
      "Enabled": true
    },
    "DataCleanupWorker": {
      "Enabled": true
    },
    "Entitlements": {
      "EnforcementMode": "report_only",
      "SignatureKey": ""
    },
    "Notifications": {
      "WorkerEnabled": true,
      "PerRecipientPerMinute": 20
    },
    "Mobile": {
      "MaxPhotoBytes": 15728640,
      "WebPushPublicKey": ""
    },
    "Rules": {
      "WorkerEnabled": true,
      "PollSeconds": 3,
      "BatchSize": 100
    }
  },
  "Graph": {
    "Enabled": false,
    "DefaultTenantId": 1,
    "Arango": {
      "BaseUrl": "http://127.0.0.1:8529",
      "Database": "aura_graph",
      "GraphName": "aura_domain",
      "Username": "aura_graph",
      "Password": "",
      "QueryMaxRuntimeSeconds": 15,
      "ConnectTimeoutSeconds": 10,
      "MaxResponseBytes": 16777216,
      "TotalTimeoutSeconds": 30,
      "AttemptTimeoutSeconds": 10,
      "MaxRetryAttempts": 2
    },
    "Projection": {
      "BatchSize": 50,
      "PollMilliseconds": 1000,
      "MaxAttempts": 12,
      "RelationshipLookbackHours": 24,
      "CoOccurrenceWindowSeconds": 300,
      "TransitionMaxGapSeconds": 1800
    },
    "Rebuild": {
      "MaxDynamicRows": 200000
    }
  },
  "Paths": {
    "FrontendRoot": ""
  },
  "Storage": {
    "CaptureRetryRoot": "",
    "SaveCaptureImageOnSuccess": true
  },
  "CaptureRetry": {
    "PreferInlineBase64": false,
    "AllowInlineBase64Fallback": false
  },
  "Ops": {
    "Alert": {
      "WebhookUrl": "",
      "FilePath": "storage/logs/alert-notify.log",
      "HealthFailIfRecentFailureMinutes": 10
    },
    "Metrics": {
      "ExposePrometheus": false
    },
    "Telemetry": {
      "EnableTracing": false,
      "OtlpEndpoint": "",
      "OtlpProtocol": "Grpc",
      "ServiceName": "Aura.Api"
    }
  },
  "ConnectionStrings": {
    "PgSql": "PLEASE_SET_CONNECTIONSTRING_PGSQL",
    "Redis": "PLEASE_SET_CONNECTIONSTRING_REDIS"
  },
  "SignalR": {
    "RedisBackplane": {
      "Enabled": false,
      "ConnectionString": "",
      "ChannelPrefix": "aura:signalr"
    }
  },
  // 生产环境请在 appsettings.Production.json 或环境中将 AllowedHosts 改为实际域名（分号分隔），避免长期使用 *。
  "AllowedHosts": "*",
  "HttpClients": {
    "Ai": {
      "TotalRequestTimeoutSeconds": 120,
      "AttemptTimeoutSeconds": 90,
      "MaxRetryAttempts": 2
    },
    "AlertNotifier": {
      "TotalRequestTimeoutSeconds": 30,
      "AttemptTimeoutSeconds": 15,
      "MaxRetryAttempts": 2
    }
  },
  "Aura": {
    "AllowInMemoryDataFallback": false
  },
  // 与 Hikvision:Isapi:GatewayMaxRequestBodyBytes 等大请求对齐，避免 Kestrel 默认限制与业务校验不一致。
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760
    }
  },
  // 海康 ISAPI：生产环境凭据请用环境变量（如 Hikvision__Isapi__DefaultPassword）或 DefaultPasswordEnvironmentVariable 指向的变量注入，勿将真实密码写入仓库。
  "Hikvision": {
    "Isapi": {
      "RequestTimeoutSeconds": 10,
      "SnapShotImageType": "JPEG",
      "UseHttps": false,
      "SkipSslCertificateValidation": false,
      "AllowInsecureDeviceTls": false,
      "DefaultUserName": "",
      "DefaultPassword": "",
      "DefaultUserNameEnvironmentVariable": "",
      "DefaultPasswordEnvironmentVariable": "",
      "MaxSnapshotBytes": 10485760,
      "MaxSdtPictureUploadBytes": 10485760,
      "GatewayEnabled": true,
      "GatewayTimeoutSeconds": 120,
      "GatewayMaxPathLength": 2048,
      "GatewayMaxRequestBodyBytes": 10485760,
      "GatewayMaxResponseTextChars": 5000000,
      "GatewayMaxResponseBinaryBytes": 52428800,
      "GatewayAuditLogEnabled": true,
      "GatewayIncludeDeviceErrorBodyIn502": true,
      "GatewayDeviceErrorBodyLogMaxChars": 512,
      "GatewayMaxRequestsPerMinute": 0,
      "TelemetryActivitiesEnabled": true,
      "DeviceApiIncludeErrorBodyIn502": true,
      "DeviceApiAuditLogEnabled": true,
      "DeviceApiMaxRequestsPerMinute": 0,
      "ConnectivityProbeTimeoutSeconds": 0,
      "AlertStream": {
        "Enabled": false,
        "DeviceIds": [],
        "PathAndQuery": "/ISAPI/Event/notification/alertStream",
        "ReconnectSeconds": 10,
        "SupervisorRefreshSeconds": 30,
        "MaxBufferBytes": 16777216,
        "PushSignalR": true,
        "IngestCaptureEnabled": true,
        "MaxImageBytes": 10485760,
        "AllowCameraChannelFallback": true,
        "CameraChannelFallbackStrategy": "first",
        "DedupWindowSeconds": 3,
        "XmlPreviewMaxChars": 4096,
        "LogHeartbeats": false
      }
    }
  }
}
