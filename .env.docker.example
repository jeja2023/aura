# Docker 部署环境变量模板。复制本文件为 .env.docker 后再按现场修改。

# 镜像拉取策略：
# - never：仅使用本机已有镜像，缺少镜像时直接失败；服务器断开互联网后推荐使用。
# - missing：临时联网部署或连接内网镜像仓库时，允许拉取本机缺失的镜像。
IMAGE_PULL_POLICY=never
COMPOSE_IGNORE_ORPHANS=true

# 容器与数据库会话时区。中国现场部署保持 Asia/Shanghai。
TZ=Asia/Shanghai
PG_TIMEZONE=Asia/Shanghai

# 运行时镜像。可以使用本地镜像标签，也可以使用内网镜像仓库地址。
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine
ARANGO_IMAGE=arangodb:3.12
API_IMAGE=aura-api:local
AI_IMAGE=aura-ai:local
MEDIA_PROVIDER_SIMULATOR_IMAGE=aura-media-provider-simulator:local

# 构建业务镜像使用的基础镜像。构建时这些镜像也必须在本机存在，或可从内网/互联网仓库拉取。
PYTHON_BASE_IMAGE=python:3.12-slim
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.201
DOTNET_ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0

# 对外发布端口。
API_PORT=9003
AI_PORT=8000
# 启动兜底：API 直连外部 AI worker 时可填分号/逗号分隔地址；运行后优先在前端“运行配置”页面维护。
# 建议保持为空，仅在数据库运行时配置不可用时作为兜底；留空则使用 Compose 内置 ai 服务。
AI_BASE_URLS=
POSTGRES_PORT=5432
REDIS_PORT=6380
ARANGO_PORT=8529
MEDIA_PROVIDER_SIMULATOR_PORT=18080

# 端口监听地址。临时联网部署时，数据库、缓存和 AI 建议只监听 127.0.0.1。
API_BIND_ADDRESS=0.0.0.0
AI_BIND_ADDRESS=127.0.0.1
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
ARANGO_BIND_ADDRESS=127.0.0.1
MEDIA_PROVIDER_SIMULATOR_BIND_ADDRESS=127.0.0.1

# ASP.NET 允许访问的主机名或 IP。多个值用英文分号分隔，例如 aura.lan;192.168.10.50。
ALLOWEDHOSTS=REPLACE_AURA_HOST_OR_IP

# PostgreSQL 容器初始化配置。
POSTGRES_DB=aura
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD

# ArangoDB 容器初始化配置。默认 AI 使用 root 账号连接。
ARANGO_ROOT_PASSWORD=REPLACE_ARANGO_ROOT_PASSWORD
ARANGO_DB=aura
ARANGO_GRAPH_DB=aura_graph
ARANGO_GRAPH_USER=aura_graph
ARANGO_GRAPH_PASSWORD=REPLACE_ARANGO_GRAPH_PASSWORD
ARANGO_USER=root
AURA_AI_REQUIRE_ARANGO=true
MEDIA_ANALYSIS_PROVIDER_SECRET=REPLACE_MEDIA_ANALYSIS_PROVIDER_SECRET
MEDIA_ANALYSIS_WEBHOOK_SECRET=REPLACE_MEDIA_ANALYSIS_WEBHOOK_SECRET
MEDIA_ANALYSIS_WORKERS_ENABLED=true
MEDIA_ANALYSIS_PUBLIC_WEBHOOK_URL=http://aura-api:5000/api/integrations/media-analysis/v1/events
MEDIA_ANALYSIS_HTTP_TOTAL_TIMEOUT_SECONDS=120
MEDIA_ANALYSIS_HTTP_ATTEMPT_TIMEOUT_SECONDS=30
MEDIA_ANALYSIS_HTTP_CONNECT_TIMEOUT_SECONDS=10
MEDIA_ANALYSIS_HTTP_MAX_RETRY_ATTEMPTS=2
MEDIA_ANALYSIS_HTTP_MAX_REQUEST_BYTES=1048576
MEDIA_ANALYSIS_HTTP_MAX_RESPONSE_BYTES=4194304
MEDIA_ANALYSIS_OUTBOUND_ALLOWED_HOST_0=
MEDIA_ANALYSIS_OUTBOUND_ALLOWED_HOST_1=
MEDIA_ANALYSIS_OUTBOUND_ALLOWED_HOST_2=
MEDIA_ANALYSIS_OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
MEDIA_ANALYSIS_OUTBOUND_ALLOW_HTTP=false
MEDIA_ANALYSIS_MTLS_CERTIFICATE_PATH=
MEDIA_ANALYSIS_MTLS_CERTIFICATE_PASSWORD_ENVIRONMENT_VARIABLE=
VECTOR_INDEX_READ_ENGINE=pgvector
VECTOR_INDEX_WRITE_MODE=pgvector
VECTOR_INDEX_ALLOW_LEGACY_READ_FALLBACK=false
GRAPH_ENABLED=true
ARANGO_GRAPH_NAME=aura_domain
ARANGO_GRAPH_QUERY_MAX_RUNTIME_SECONDS=15
ARANGO_GRAPH_CONNECT_TIMEOUT_SECONDS=10
ARANGO_GRAPH_MAX_RESPONSE_BYTES=16777216

# 仅用于 `docker compose --profile dev-tools` 的通用模拟提供方。
MEDIA_PROVIDER_SIMULATOR_CODE=simulator
MEDIA_PROVIDER_SIMULATOR_TENANT=aura-default
MEDIA_PROVIDER_SIMULATOR_SECRET=development-only-secret

# 可选的 AI 调用密钥。非空时 API 与 AI 必须保持一致。
AURA_API_KEY=

# AI 推理与检索保护参数。生产环境按机器性能、GPU/CPU worker 数量和抓拍峰值压测后调整。
AURA_AI_INFER_BATCH_SIZE=16
AURA_AI_INFER_MAX_WAIT_SECONDS=0.05
AURA_AI_INFER_QUEUE_MAX_SIZE=256
AURA_AI_INFER_ENQUEUE_TIMEOUT_SECONDS=0.2
AURA_AI_SEARCH_RATE_LIMIT_PER_MINUTE=600
# 熔断阈值同时作用于检索保护和远程推理节点；单节点连续失败后会临时跳过。
AURA_AI_BREAKER_FAIL_THRESHOLD=8
AURA_AI_BREAKER_OPEN_SECONDS=20
AURA_AI_HEALTH_VERBOSE=false
AURA_AI_EXTRACT_FILE_ROOTS=
# AI 图片输入限制：Base64 字符数、像素数和格式白名单
AURA_AI_MAX_IMAGE_BASE64_CHARS=20000000
AURA_AI_MAX_IMAGE_PIXELS=16000000
AURA_AI_ALLOWED_IMAGE_FORMATS=JPEG,PNG,BMP,WEBP
AURA_AI_INDEX_SNAPSHOT_PATH=data/ai/local_index_snapshot.json
AURA_AI_MIN_SCORE_DEFAULT=-1.0
AURA_AI_CANDIDATE_MULTIPLIER_DEFAULT=8
AURA_AI_CANDIDATE_POOL_DEFAULT=0
AURA_AI_ANN_PROBE_DEFAULT=16
AURA_AI_RERANK_WINDOW_DEFAULT=30

# 外部图片特征服务对接。若外部服务已经负责图片解码、预处理和特征提取，填写本组地址；
# 根地址会自动补 /ai/extract。启用后优先于下方张量级 GPU worker。
# 多个地址支持英文分号/逗号/换行分隔，也支持 URL|权重，例如 http://external-ai:8000|2。
AURA_EXTERNAL_EXTRACT_URLS=
AURA_EXTERNAL_PROJECT_NAME=person_reid
AURA_EXTERNAL_MODEL_NAME=osnet_x1_0_v1.onnx
AURA_EXTERNAL_API_TOKEN=
AURA_EXTERNAL_TIMEOUT_SECONDS=10

# 张量级 GPU 推理服务对接。本项目 AI 服务负责图片解码/预处理，只把 tensor_data 发给 GPU worker。
# docker-compose.yml 已内置默认值；仅当现场 GPU worker 地址、project_name、model_name 或 token 不一致时覆盖。
# GPU 服务按共享模型根目录下的 <project_name>/<model_name> 查找模型。
# 多个地址支持 URL|权重；未写权重时按 1 处理。
AURA_GPU_PREDICT_URLS=http://gpu-worker-0:8000/predict|1;http://gpu-worker-1:8000/predict|1
AURA_GPU_PROJECT_NAME=person_reid
AURA_GPU_MODEL_NAME=osnet_x1_0_v1.onnx
AURA_GPU_API_TOKEN=
AURA_GPU_TIMEOUT_SECONDS=10

# 数据库升级迁移参数。db-migrate 会使用 PostgreSQL advisory lock 防止并发升级。
DB_MIGRATION_COMMAND_TIMEOUT_SECONDS=300
DB_MIGRATION_LOCK_TIMEOUT_SECONDS=60

# SignalR Redis backplane。单个 API 容器部署时保持 false。
SIGNALR__REDISBACKPLANE__ENABLED=false
SIGNALR__REDISBACKPLANE__CHANNELPREFIX=aura:signalr

# 安全密钥。部署前必须替换所有占位值。
JWT__KEY=REPLACE_WITH_LONG_RANDOM_JWT_KEY
SECURITY__HMACSECRET=REPLACE_WITH_LONG_RANDOM_HMAC_SECRET
# 生产默认要求 HTTPS/反代；若临时使用纯 HTTP 直连验证，可短时改为 false。
SECURITY__COOKIES__FORCESECURE=true
SECURITY__FORWARDEDHEADERS__ENABLED=true
SECURITY__FORWARDEDHEADERS__FORWARDLIMIT=2
# 按现场反代/Ingress 网段收窄；默认覆盖常见私有网段。
SECURITY__FORWARDEDHEADERS__KNOWNNETWORKS__0=10.0.0.0/8
SECURITY__FORWARDEDHEADERS__KNOWNNETWORKS__1=172.16.0.0/12
SECURITY__FORWARDEDHEADERS__KNOWNNETWORKS__2=192.168.0.0/16

# 初始管理员账号与检查脚本使用的账号。
AURA_ADMIN_USER=admin
AURA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# 运维与可观测性配置。
OPS__ALERT__WEBHOOKURL=
OPS__ALERT__FILEPATH=/app/storage/logs/alert-notify.log
OPS__METRICS__EXPOSEPROMETHEUS=false
OPS__TELEMETRY__ENABLETRACING=false
OPS__TELEMETRY__OTLPENDPOINT=
OPS__TELEMETRY__OTLPPROTOCOL=Grpc

# 宿主机挂载路径。相对路径按 docker/docker-compose.yml 所在目录解析。
AURA_MODEL_HOST_DIR=../models
AURA_MODEL_PATH=/app/models/osnet_ibn_x1_0.onnx
FRONTEND_HOST_DIR=../frontend
PATHS__FRONTENDROOT=/app/frontend
